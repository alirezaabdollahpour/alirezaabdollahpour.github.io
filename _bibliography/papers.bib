  abbr={Preprint},
  bibtex_show={true},
  title={{OptiSelect}: How does the Optimizer Shape Data Curriculum?},
  author={Fan, Simin and Abdollahpoorrostam, Alireza and Jaggi, Martin},
  journal={arXiv preprint},
  year={2026},
  eprint={2610.03432},
  archivePrefix={arXiv},
  primaryClass={cs.LG},
  arxiv={2610.03432},
  url={https://arxiv.org/abs/2610.03432},
  pdf={https://arxiv.org/pdf/2610.03432},
  abstract={OptiSelect is an optimizer-aware online data selection framework for efficient LLM pretraining. We characterize how optimizer geometry shapes the value of candidate training examples and derive a principle linking selection gains to the discriminability of utility scores. Experiments on 124M- and 720M-parameter models support practical recipes for combining data selection with AdamW and Muon, including under data rephrasing.},
  selected={true}
}

