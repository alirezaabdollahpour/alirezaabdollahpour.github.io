  slides={brenier_adversarial_training_slides.pptx},
  abstract={We study Wasserstein-penalized distributionally robust learning through transport maps and show that optimal adversarial maps are cyclically monotone. Standard per-sample adversarial training can violate this structure and waste transport cost. We develop multi-start particle ascent with reassignment and adversarial maps parameterized by gradients of input-convex neural networks, improving robustness and generalization under distribution shift.},
